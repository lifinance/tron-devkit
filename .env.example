# Nothing in this repo loads a .env file. These are the variables the library reads from the
# environment of the script that imports it (for example in contracts or contracts-tron).

# Required by scripts that call getPrivateKey() without a key argument: deployer private key, hex with or without 0x.
PRIVATE_KEY=

# Optional: Tron mainnet RPC URL for getTronRpcUrl('tron'); defaults to https://api.trongrid.io.
RPC_URL_TRON=

# Optional: Tron Shasta testnet RPC URL for getTronRpcUrl('tronshasta'); defaults to https://api.shasta.trongrid.io.
RPC_URL_TRONSHASTA=

# Optional: TronGrid API key, sent with TronGrid requests to reduce rate limiting.
TRONGRID_API_KEY=

# Optional: fee_limit in SUN for Safe execTransaction broadcasts; positive integer, defaults to 50000000 (50 TRX).
TRON_SAFE_EXEC_FEE_LIMIT_SUN=
